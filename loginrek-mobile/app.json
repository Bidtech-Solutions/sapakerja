{
  "expo": {
    "name": "SapaKerja",
    "slug": "loginrek",
    "scheme": "loginrek",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.co.bidtech.loginrek",
      "usesAppleSignIn": true,
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SapaKerja membutuhkan akses kamera untuk foto selfie absensi.",
        "NSLocationWhenInUseUsageDescription": "SapaKerja membutuhkan akses lokasi untuk memastikan Anda berada di area kantor.",
        "NSPhotoLibraryUsageDescription": "SapaKerja membutuhkan izin akses galeri foto untuk mengubah foto profil akun Anda.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "id.co.bidtech.loginrek",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBIPE5ig24GNm1qoVCvrAXl2WHqKy5U5kA"
        }
      },
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B7F78",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B7F78"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-localization",
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SapaKerja hanya memakai lokasi saat aplikasi sedang dibuka, bukan di latar belakang.",
          "locationAlwaysPermission": "SapaKerja hanya memakai lokasi saat aplikasi sedang dibuka, bukan di latar belakang.",
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": "SapaKerja membutuhkan lokasi yang presisi untuk memastikan Anda berada di area kantor saat absen."
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B7F78",
          "defaultChannel": "default",
          "sounds": [
            "./assets/notifications/sapakerja_notification.wav",
            "./assets/notifications/sapakerja_notification_2.wav"
          ]
        }
      ],
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.307840385367-u28qonfbb11o69kjjviqib135r1el451"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da2c26bc-bc7b-447e-a50e-160af56919a7"
      }
    },
    "owner": "bidtech-solutions",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://api.sapakerja.com/updates/manifest",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
